    <!-- About and privacy -->
    <string name="about_title">About and privacy</string>
    <string name="about_storage_title">Where your data is stored</string>
    <string name="about_storage_body">Journal entries, tasks, reminders, transactions and settings are stored only in this app\'s private storage on this device. Other apps cannot read it. The app has no internet permission and never sends data anywhere.</string>
    <string name="about_encryption_title">Encryption</string>
    <string name="about_encryption_body">The app\'s database is not separately encrypted. It is protected by Android\'s app sandbox and, on most modern phones, by device encryption tied to your screen lock. Use a screen lock to keep your journal and finances private.</string>
    <string name="about_backup_title">Backups</string>
    <string name="about_backup_body">This app is excluded from Android\'s automatic cloud backup, so your data is not copied to Google Drive. Files you export (CSV or backups) are saved where you choose and are not encrypted — keep them somewhere safe.</string>
    <string name="about_uninstall_title">If you uninstall the app</string>
    <string name="about_uninstall_body">Uninstalling deletes all of the app\'s data permanently. Export a backup first if you want to keep it.</string>
    <string name="about_lost_title">If you lose your phone or reset it</string>
    <string name="about_lost_body">Your data cannot be recovered from anywhere else, because nothing is stored online. Only your own exported backups can restore it. A screen lock prevents others from opening the app\'s data on a lost phone.</string>
    <string name="about_reminders_title">Reminders</string>
    <string name="about_reminders_body">Reminders use Android\'s alarm system. Android or your phone\'s battery saver can delay them, and exact timing cannot be guaranteed on every device.</string>
    <string name="about_no_ai_title">No AI</string>
    <string name="about_no_ai_body">The app does not use AI. Everything you see is calculated directly from what you entered.</string>

